# SATUSEHAT Environment Configuration
# Options: 'staging' (Default for sandbox/dev) or 'production'
SATUSEHAT_ENV=staging

# SATUSEHAT Developer Credentials (Dapatkan dari Portal Pengembang SATUSEHAT: https://satusehat.kemkes.go.id/platform)
SATUSEHAT_CLIENT_ID=your_client_id_here
SATUSEHAT_CLIENT_SECRET=your_client_secret_here

# ID Organisasi Faskes / Rumah Sakit / Klinik
SATUSEHAT_ORG_ID=your_organization_id_here

# Base URLs (Optional override)
# STAGING_AUTH_URL=https://api-satusehat-stg.dto.kemkes.go.id/oauth2/v1
# PROD_AUTH_URL=https://api-satusehat.kemkes.go.id/oauth2/v1
# STAGING_FHIR_URL=https://api-satusehat-stg.dto.kemkes.go.id/fhir-r4/v1
# PROD_FHIR_URL=https://api-satusehat.kemkes.go.id/fhir-r4/v1
