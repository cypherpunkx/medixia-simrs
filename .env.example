# ==============================================================================
# MEDIXIA SIMRS (MULTI-TENANT) - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin file ini menjadi `.env.local` untuk pengembangan lokal, atau pasang pada
# Environment Secrets di server deployment Anda (Docker / Kubernetes / VPS / Cloud).
#
# PENTING (ARSITEKTUR MULTI-TENANT):
# Kredensial SATUSEHAT (Client ID, Client Secret, Organization ID) TIDAK LAGI
# disimpan di file .env ini. Setiap fasilitas kesehatan (RS / Klinik / Praktik
# Mandiri) mengelola kredensialnya masing-masing secara terisolasi di database
# (tabel `facilities`) dan dienkripsi dengan AES-256-GCM.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Koneksi database PostgreSQL terpusat untuk data rekam medis, akun pengguna,
# pendaftaran fasilitas kesehatan (multi-tenant), dan antrean Outbox SATUSEHAT.
#
# Format: postgres://<username>:<password>@<host>:<port>/<database_name>
# Contoh Lokal: postgres://postgres:admin@localhost:5432/medixia_simrs
# Contoh Cloud: postgresql://user:secret@ep-sample.ap-southeast-1.aws.neon.tech/medixia_simrs?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medixia_simrs

# ------------------------------------------------------------------------------
# 2. APPLICATION SECURITY & SESSION (JWT)
# ------------------------------------------------------------------------------
# Secret key untuk penandatanganan JWT Cookie Sesi Staf / Nakes (HMAC-SHA256).
# Wajib diganti dengan string acak dengan entropi tinggi (minimal 32 karakter).
# Tip generate di terminal: openssl rand -base64 32
SESSION_SECRET=ganti_dengan_kunci_rahasia_jwt_minimal_32_karakter_acak

# ------------------------------------------------------------------------------
# 3. MULTI-TENANT DATA ENCRYPTION KEY (AES-256-GCM)
# ------------------------------------------------------------------------------
# Kunci enkripsi simetris untuk mengenkripsi Client Secret SATUSEHAT faskes di DB.
# String acak 32 karakter atau 64 hex characters (256-bit).
# JANGAN PERNAH mengubah kunci ini setelah ada faskes yang terdaftar di produksi,
# karena data rahasia tersimpan tidak akan bisa didekripsi kembali.
# Tip generate di terminal: openssl rand -hex 32
APP_ENCRYPTION_KEY=ganti_dengan_kunci_aes256_32_karakter_atau_hex64_produksi

# ------------------------------------------------------------------------------
# 4. APPLICATION BASE URL (Internal Worker & Callback)
# ------------------------------------------------------------------------------
# Digunakan oleh background worker Outbox SATUSEHAT untuk memproses antrean retry.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 5. PANDUAN PENDAFTARAN KREDENSIAL FASKES (SATUSEHAT)
# ------------------------------------------------------------------------------
# Kredensial SATUSEHAT faskes kini didaftarkan langsung melalui:
# - Antarmuka Web Manajemen Fasilitas / Super Admin SIMRS, ATAU
# - Script seeder database SQL (tabel `facilities`).
#
# Kolom yang dikonfigurasi per-faskes di database:
# - satusehat_env               : 'staging' atau 'production'
# - satusehat_org_id            : UUID Organisasi Faskes dari Kemenkes DTO
# - satusehat_client_id         : Client ID OAuth2 Kemenkes
# - satusehat_client_secret_enc : Terenkripsi otomatis dengan APP_ENCRYPTION_KEY
