# ==============================================================================
# MEDIXIA SIMRS & SATUSEHAT INTEGRATION - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin file ini menjadi `.env.local` untuk pengembangan lokal, atau pasang pada
# Environment Secrets di server deployment faskes Anda (Docker / Kubernetes / Vercel).
# JANGAN PERNAH menyimpan kredensial produksi asli ke dalam git repository.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Koneksi database relasional SIMRS untuk penyimpanan data rekam medis, akun nakes,
# data pasien, pendaftaran antrean, dan outbox resiliensi SATUSEHAT.
#
# Format: postgres://<username>:<password>@<host>:<port>/<database_name>
# Contoh Lokal: postgres://postgres:postgres@localhost:5432/medixia_simrs
# Contoh Cloud (Neon / Supabase / AWS RDS):
# DATABASE_URL=postgresql://user:secret@ep-sample.ap-southeast-1.aws.neon.tech/medixia_simrs?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medixia_simrs

# ------------------------------------------------------------------------------
# 2. APPLICATION SECURITY & SESSION CONFIGURATION
# ------------------------------------------------------------------------------
# Secret key untuk penandatanganan JWT Cookie Sesi Staf / Nakes (HMAC-SHA256).
# Wajib diganti dengan string acak dengan entropi tinggi (minimal 32-64 karakter)
# untuk memitigasi pemalsuan token autentikasi di lingkungan produksi.
# Tip generate: jalankan `openssl rand -base64 32` di terminal.
SESSION_SECRET=ganti_dengan_kunci_rahasia_acak_minimal_32_karakter_produksi

# ------------------------------------------------------------------------------
# 3. KEMENKES SATUSEHAT PLATFORM INTEGRATION
# ------------------------------------------------------------------------------
# Lingkungan integrasi SATUSEHAT:
# - 'staging'    : Mode Sandbox pengujian / uji coba sertifikasi Kemenkes
# - 'production' : Mode Live Produksi faskes resmi terdaftar di Kemenkes RI
SATUSEHAT_ENV=staging

# Kredensial Pengembang SATUSEHAT (Client ID & Client Secret)
# Dapatkan dari Portal Pengembang SATUSEHAT: https://satusehat.kemkes.go.id/platform
SATUSEHAT_CLIENT_ID=your_satusehat_client_id_here
SATUSEHAT_CLIENT_SECRET=your_satusehat_client_secret_here

# ID Organisasi Faskes (UUID Rumah Sakit / Klinik / Puskesmas)
# Diperoleh setelah faskes didaftarkan dan diverifikasi di SATUSEHAT
SATUSEHAT_ORG_ID=your_organization_uuid_here

# (Opsional) Default Practitioner IHS ID DPJP / Dokter Pemeriksa
# Digunakan sebagai fallback jika profil akun dokter belum memiliki nomor IHS Kemenkes.
# Format: Numerik (misal: 10002134567) atau berawalan N (misal: N10002134567).
SATUSEHAT_DOCTOR_IHS=10002134567

# ------------------------------------------------------------------------------
# 4. SATUSEHAT GATEWAY URL OVERRIDES (OPTIONAL)
# ------------------------------------------------------------------------------
# Hapus tanda komentar jika faskes Anda menggunakan API Gateway proxy internal
# atau mock gateway khusus dalam jaringan rumah sakit:
# STAGING_AUTH_URL=https://api-satusehat-stg.dto.kemkes.go.id/oauth2/v1
# PROD_AUTH_URL=https://api-satusehat.kemkes.go.id/oauth2/v1
# STAGING_FHIR_URL=https://api-satusehat-stg.dto.kemkes.go.id/fhir-r4/v1
# PROD_FHIR_URL=https://api-satusehat.kemkes.go.id/fhir-r4/v1
